#!/usr/bin/env bash
set -e

CORE_DIR="$HOME/NEXUS_ULTIMATE_CORE"
SOCKET="$HOME/.nexus_host.sock"
DAEMON_BIN="$HOME/.local/bin/nexus_host_daemon"

export RISH_APPLICATION_ID="com.termux"
export LD_LIBRARY_PATH="/data/data/com.termux/files/usr/lib:$LD_LIBRARY_PATH"

start_daemon_if_needed() {
    if ! pgrep -f "nexus_host_daemon" > /dev/null; then
        echo "[*] Iniciando Nexus Host Daemon de fondo..."
        "$DAEMON_BIN" > /dev/null 2>&1 &
        sleep 1
    fi
}

case "$1" in
    daemon)
        case "$2" in
            start)
                start_daemon_if_needed
                echo "[OK] Nexus Host Daemon corriendo."
                ;;
            stop)
                pkill -f "nexus_host_daemon" 2>/dev/null && echo "[OK] Daemon detenido." || echo "[!] No había daemon en ejecución."
                ;;
            status)
                if pgrep -f "nexus_host_daemon" > /dev/null; then
                    echo "[OK] Daemon activo (PID: $(pgrep -f 'nexus_host_daemon' | tr '\n' ' '))"
                else
                    echo "[!] Daemon inactivo."
                fi
                ;;
            *)
                echo "Uso: nexus daemon {start|stop|status}"
                ;;
        esac
        ;;

    screen)
        start_daemon_if_needed
        python3 -c "
import socket, json
s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
s.connect('$SOCKET')
s.sendall(b'{\"action\":\"GetScreenSize\"}\n')
res = json.loads(s.recv(1024).decode())
print(res.get('result', 'Error'))
s.close()
"
        ;;

    shot)
        start_daemon_if_needed
        python3 -c "
import socket, json
s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
s.connect('$SOCKET')
s.sendall(b'{\"action\":\"Screenshot\"}\n')
res = json.loads(s.recv(1024).decode())
print('[OK] Captura guardada en:', res.get('result', 'Error'))
s.close()
"
        ;;

    tap)
        if [ -z "$2" ] || [ -z "$3" ]; then
            echo "Uso: nexus tap <X> <Y>"
            exit 1
        fi
        start_daemon_if_needed
        python3 -c "
import socket, json
s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
s.connect('$SOCKET')
s.sendall(b'{\"action\":\"Tap\",\"payload\":{\"x\":$2,\"y\":$3}}\n')
res = json.loads(s.recv(1024).decode())
print('[OK] Tap emitido:', res)
s.close()
"
        ;;

    exec)
        shift
        CMD="$*"
        if [ -z "$CMD" ]; then
            echo "Uso: nexus exec <comando shell>"
            exit 1
        fi
        start_daemon_if_needed
        python3 -c "
import socket, json
s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
s.connect('$SOCKET')
payload = json.dumps({\"action\":\"Exec\",\"payload\":{\"command\": \"\"\"$CMD\"\"\"}})
s.sendall(f'{payload}\n'.encode())
res = json.loads(s.recv(4096).decode())
print(res.get('result', 'Error'))
s.close()
"
        ;;

    agent)
        start_daemon_if_needed
        shift
        python3 "$CORE_DIR/agents/nexus_core_agent.py" "$@"
        ;;

    *)
        echo "Comando Nexus CLI"
        echo "Uso: nexus [daemon|screen|shot|tap|exec|agent] [opciones]"
        ;;
esac
