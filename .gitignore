# --- EXCEPCIÓN: código fuente Rust dentro de src/bin/ (bins del crate) ---
!core/src/bin/
core/src/bin/*
!core/src/bin/*.rs
!**/src/bin/
**/src/bin/*
!**/src/bin/*.rs
!**/src/bin/*.wgsl

# --- Trading portal: se versiona el código fuente; se excluye solo lo sensible ---
trading-portal/.vault/
