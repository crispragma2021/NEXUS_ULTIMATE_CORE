# ═══════════════════════════════════════════════════════════════════════════
# 🔱 NEXUS CUA — DOCKER HEADLESS GUI (Xvfb + noVNC + Chromium)
# Entorno primario del Computer-Using Agent.
# Incluye: NEXUS HANDS — control real de mouse/teclado (xdotool + PyAutoGUI)
# ═══════════════════════════════════════════════════════════════════════════
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive \
    DISPLAY=:99 \
    RESOLUTION=1920x1080x24 \
    NOVNC_PORT=6080 \
    VNC_PASSWORD=nexus

# ─── Dependencias base ─────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    xvfb \
    x11vnc \
    novnc \
    websockify \
    fluxbox \
    xdotool \
    curl \
    wget \
    ca-certificates \
    fonts-liberation \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libcups2 \
    libdbus-1-3 \
    libdrm2 \
    libgbm1 \
    libgtk-3-0 \
    libnspr4 \
    libnss3 \
    libx11-xcb1 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libxss1 \
    xdg-utils \
    python3 \
    python3-pip \
    python3-xlib \
    python3-tk \
    tesseract-ocr \
    imagemagick \
    x11-apps \
    scrot \
    && rm -rf /var/lib/apt/lists/*

# ─── Chromium (para automatización de navegador) ──────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    chromium-browser \
    && rm -rf /var/lib/apt/lists/*

# ─── NEXUS HANDS — PyAutoGUI (control de input X11) ───────────────────────
RUN pip3 install --no-cache-dir pyautogui

# ─── Nexus Hands script (input humano real) ───────────────────────────────
COPY nexus_hands.py /opt/nexus_hands.py
COPY nexus_vault.py /opt/nexus_vault.py
COPY nexus_captcha_local.py /opt/nexus_captcha_local.py
RUN chmod +x /opt/nexus_hands.py /opt/nexus_vault.py /opt/nexus_captcha_local.py

# ─── Script de entrada ─────────────────────────────────────────────────────
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

EXPOSE 6080 5900

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
