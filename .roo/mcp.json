		},
		"nexus-consultar": {
			"command": "/usr/bin/node",
			"args": [
				"/home/soberano/NEXUS_ULTIMATE_CORE/scripts/mcp/nexus_mcp_consultar.cjs"
			],
			"alwaysAllow": [
				"consultar_nexus"
			],
			"disabled": false
		},
		"nexus-browser": {
			"command": "/usr/bin/node",
			"args": [
				"/home/soberano/NEXUS_ULTIMATE_CORE/scripts/mcp/nexus_browser_mcp.cjs"
			],
			"alwaysAllow": [
				"browser_navigate",
				"browser_screenshot",
