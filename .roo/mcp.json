			],
			"alwaysAllow": [
				"omega_deep_search"
			],
			"timeout": 300
		},
		"nexus-sys": {
			"command": "/usr/bin/node",
			"args": [
				"/home/soberano/NEXUS_ULTIMATE_CORE/scripts/mcp/nexus_sys_mcp.cjs"
			],
			"alwaysAllow": [
				"sys_free_port",
