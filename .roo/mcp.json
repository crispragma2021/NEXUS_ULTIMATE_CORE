				"browser_type_human",
				"browser_hover",
				"browser_scroll",
				"browser_eval",
				"browser_get_dom",
				"browser_close",
				"browser_resolve_captcha"
			]
		},
		"nexus-parallel": {
			"command": "/usr/bin/node",
			"args": [
				"/home/soberano/NEXUS_ULTIMATE_CORE/scripts/mcp/nexus_parallel_mcp.cjs"
			],
			"alwaysAllow": [
				"parallel_run",
				"parallel_analyze",
