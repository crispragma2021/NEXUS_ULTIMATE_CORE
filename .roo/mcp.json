{
	"mcpServers": {
		"nexus-claws-mcp": {
			"command": "/home/soberano/NEXUS_ULTIMATE_CORE/bin/claws-mcp",
			"args": [],
			"alwaysAllow": [
				"leer_archivo",
				"escribir_archivo",
