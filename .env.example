# ─────────────────────────────────────────────────────────────────────────────
# NEXUS_ULTIMATE_CORE — plantilla de configuración
# Copia este archivo a `.env` y rellena. `.env` está en .gitignore: las llaves
# NO se versionan.
# ─────────────────────────────────────────────────────────────────────────────

# ── Llaves API ───────────────────────────────────────────────────────────────
# Agente principal (nexus agent / nexusnet)
DEEPSEEK_API_KEY=tu_clave_aqui

# Pool de llaves de Gemini. Varias separadas por espacio o coma.
# OJO: rotar llaves NO suma cuota. Gemini limita por PROYECTO de Google Cloud,
# no por llave: todas las llaves de un proyecto comparten el mismo presupuesto.
# Sirve para repartir carga entre proyectos distintos, no para esquivar el 429.
NEXUS_GEMINI_KEYS=tu_clave_1 tu_clave_2

# ── Cadena de modelos con fallback ───────────────────────────────────────────
# Orden de intento. Si el primero responde 503 UNAVAILABLE o 429, el transporte
# salta de inmediato al siguiente sin intervención manual.
NEXUS_GEMINI_MODEL_CHAIN=gemini-3.8-flash,gemini-3.7-flash,gemini-1.5-flash

# Modelo inicial explícito (opcional; por defecto se usa el primero de la cadena)
# NEXUS_GEMINI_MODEL=gemini-3.8-flash

# ── Proveedor de chat (opcional) ─────────────────────────────────────────────
# NEXUS_CHAT_URL=https://api.deepseek.com/v1/chat/completions
# NEXUS_CHAT_MODEL=deepseek-chat

# ── Cascada de proveedores ───────────────────────────────────────────────────
# La redundancia real está entre PROVEEDORES, no entre llaves del mismo
# proveedor (Gemini limita por proyecto; OpenRouter gobierna la capacidad
# globalmente). Se prueban en este orden y se salta al siguiente ante
# 429 / 402 / 5xx / fallo de red:
#
#   deepseek -> groq -> cerebras -> github -> openrouter -> gemini -> ollama
#
# Con UNA sola llave el agente ya funciona; cada llave extra es un tanque de
# reserva. `nexus doctor` muestra cuánta cuota le queda hoy a cada uno.

# Groq — 30 RPM y ~1.000 peticiones/día por modelo. Gratis, sin tarjeta.
#   https://console.groq.com/keys -> "Create API Key"
GROQ_API_KEY=

# Cerebras — ~1 millón de tokens/día gratis. Contexto de 8K en plan gratuito.
#   https://cloud.cerebras.io -> API Keys
CEREBRAS_API_KEY=

# OpenRouter — 50 peticiones/día gratis; con $10 de créditos (pago único, los
# créditos no caducan) sube a 1.000/día. Solo los modelos :free cuentan ahí.
#   https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# GitHub Models — ~15 RPM y 150/día con tu token de GitHub (Copilot Free).
#   https://github.com/settings/tokens -> fine-grained, sin scopes especiales
# GITHUB_TOKEN=

# Ollama local — último recurso, nunca se agota. Solo viable en la PC.
# NEXUS_OLLAMA_URL=http://127.0.0.1:11434

# Reordenar o recortar la cascada (opcional):
# NEXUS_PROVIDERS=groq,openrouter,gemini
# Forzar el modelo de un proveedor (opcional):
# NEXUS_GROQ_MODEL=llama-3.1-8b-instant
# NEXUS_OPENROUTER_MODEL=openrouter/auto

# ── Advertencia sobre Google AI Studio ───────────────────────────────────────
# Activar la facturación en un proyecto que usaba el nivel gratuito ELIMINA el
# nivel gratuito. No lo hagas esperando ganar cuota: la pierdes entera.

# ── Rutas (todas opcionales) ─────────────────────────────────────────────────
# Socket del daemon. Por defecto $HOME/.nexus_host.sock en ambos entornos.
# En Termux: /data/data/com.termux/files/home/.nexus_host.sock
# NEXUS_SOCKET_PATH=/data/data/com.termux/files/home/.nexus_host.sock

# Raíz temporal. Si no se define, se resuelve sola:
#   Android/Termux -> $TMPDIR, luego $PREFIX/tmp, luego $HOME/tmp
#   PC Linux       -> $TMPDIR, luego /tmp          (comportamiento original)
#   PC Windows     -> %TEMP%, %TMP%, %LOCALAPPDATA%\Temp
# NEXUS_TMPDIR=

# Ubicación del historial de conversación.
# NEXUS_MEMORY_FILE=

# Dónde guarda el daemon las capturas de pantalla.
# NEXUS_SCREENSHOT_PATH=

# ── Ajuste de memoria para aarch64 con poca RAM libre ────────────────────────
# normal | low | critical. Por defecto se detecta solo según la RAM disponible
# (< 1 GB libre -> low, < 448 MB -> critical) y recorta buffers, historial y
# desactiva la traza [Cache Audit].
# NEXUS_MEM_PROFILE=low

# ── Varios ───────────────────────────────────────────────────────────────────
# NEXUS_TRANSPORT_DEBUG=1
# NEXUS_CMD_TIMEOUT=20
# NEXUS_GEMINI_TIMEOUT=30
# NEXUS_GODOT_PROJECT_DIR=
# NEXUS_CORE_DIR=
