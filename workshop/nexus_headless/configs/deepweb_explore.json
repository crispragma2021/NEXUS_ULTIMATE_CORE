{
  "name": "🕶️ Deep Web — Exploración Profunda",
  "description": "Hidden Wiki + CIA FOIA (nombres) + TorWire directory + búsquedas específicas",
  "userDataDir": "/home/soberano/.nexus_profile",
  "headless": false,
  "proxy": "socks5://127.0.0.1:9050",
  "useProxy": true,
  "urlTimeout": 90000,
  "urlWaitUntil": "domcontentloaded",

  "phases": {
    "searchEngines": false,
    "portals": false,
    "directURLs": true,
    "warmup": ["tor", "browser"],
    "cooldown": ["report"]
