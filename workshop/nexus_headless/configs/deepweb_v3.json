          "timeout": 30000,
          "scroll": false,
          "waitUntil": "domcontentloaded",
          "noProxy": true
        },
        "Búsqueda email paraguay": {
          "url": "https://intelx.io/?s=paraguay",
          "timeout": 45000,
          "scroll": true,
          "waitUntil": "networkidle0",
          "noProxy": true
