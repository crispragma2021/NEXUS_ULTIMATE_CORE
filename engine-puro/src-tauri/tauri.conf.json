{
  "productName": "Cerebro Digital",
  "version": "1.0.0",
  "identifier": "com.nexus.cerebro-digital",
  "build": {
    "frontendDist": "../src-tauri/dist",
    "devUrl": "http://localhost:43211",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "🧬 Cerebro Digital — Hodgkin-Huxley Visualizer",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
