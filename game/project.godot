; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="NEXUS Protocol"
config/description="Mundo procedural low-poly isométrico por chunks — Fase Beta NEXUS"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icon.svg"

[autoload]

NexusWorld="*res://autoload/World.gd"
NexusConfig="*res://autoload/Config.gd"
NexusSkillManager="*res://autoload/SkillManager.gd"
NexusCombatManager="*res://autoload/CombatManager.gd"
NexusLLMBridge="*res://autoload/LLMBridge.gd"
McpInteractionServer="*res://autoload/McpInteractionServer.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="viewport"
window/stretch/aspect="expand"

[input]

ui_click={
"deadzone": 0.5,
"events": [{
"alt": false,
"button_index": 0,
"button_mask": 0,
"command": false,
"ctrl": false,
"meta": false,
"mouse_button": 1,
"pressure": 0.0,
"shift": false,
"tilt_x": 0.0,
"tilt_y": 0.0,
"type": 11
}]
}
ui_right_click={
"deadzone": 0.5,
"events": [{
"alt": false,
"button_index": 0,
"button_mask": 0,
"command": false,
"ctrl": false,
"meta": false,
"mouse_button": 2,
"pressure": 0.0,
"shift": false,
"tilt_x": 0.0,
"tilt_y": 0.0,
"type": 11
}]
}
ui_shift={
"deadzone": 0.5,
"events": [{
"alt": false,
"command": false,
"ctrl": false,
"echo": false,
"keycode": 16777248,
"meta": false,
"physical_scancode": 42,
"pressed": true,
"scancode": 42,
"shift": false,
"type": 2,
"unicode": 0
}]
}
ui_click_released={
"deadzone": 0.5,
"events": [{
"alt": false,
"button_index": 0,
"button_mask": 0,
"command": false,
"ctrl": false,
"meta": false,
"mouse_button": 1,
"pressed": false,
"pressure": 0.0,
"shift": false,
"tilt_x": 0.0,
"tilt_y": 0.0,
"type": 11
}]
}
ui_right_click_released={
"deadzone": 0.5,
"events": [{
"alt": false,
"button_index": 0,
"button_mask": 0,
"command": false,
"ctrl": false,
"meta": false,
"mouse_button": 2,
"pressed": false,
"pressure": 0.0,
"shift": false,
"tilt_x": 0.0,
"tilt_y": 0.0,
"type": 11
}]
}

[input_devices]

pointing/emulate_touch_from_mouse=true

[layer_names]

3d_physics/layer_1="terreno"
3d_physics/layer_2="jugador"
3d_physics/layer_3="entidades"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.09, 0.11, 0.16, 1)
gui/theme/default_font_generate_mipmaps=true
