[Unit]
Description=NEXUS TLS Terminator Service (Port 8443)
After=network.target nexus-proxy.service

[Service]
Type=simple
User=soberano
WorkingDirectory=/home/soberano/NEXUS_ULTIMATE_CORE
ExecStart=/usr/bin/node /home/soberano/NEXUS_ULTIMATE_CORE/scripts/tls_terminator.cjs
Restart=always
RestartSec=5
Environment=NODE_ENV=production

[Install]
WantedBy=default.target
