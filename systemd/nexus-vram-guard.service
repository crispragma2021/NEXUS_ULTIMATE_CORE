[Unit]
Description=NEXUS VRAM Guard - Blindaje de VRAM para Ollama Qwen
After=network.target ollama.service
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=oneshot
User=soberano
Environment="PATH=/usr/local/bin:/usr/bin:/bin"
WorkingDirectory=/home/soberano/NEXUS_ULTIMATE_CORE
ExecStart=/bin/bash /home/soberano/NEXUS_ULTIMATE_CORE/scripts/vram_guard.sh

# El guard es rápido; no bloquear indefinidamente
TimeoutStartSec=60

[Install]
WantedBy=multi-user.target
