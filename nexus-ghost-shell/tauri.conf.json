{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "nexus-ghost",
  "version": "1.0.0",
  "identifier": "com.nexus.ghost",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "ui"
  },
  "app": {
    "windows": [
      {
        "title": "NEXUS GHOST",
        "label": "main",
        "width": 380,
        "height": 550,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: https: data:; connect-src 'self' http://localhost:43211 ws://localhost:43211"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"]
  }
}
